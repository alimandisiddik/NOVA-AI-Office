TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_ALLOWED_USER_ID=replace_with_numeric_user_id
NOVA_ENV=development
NOVA_MEMORY_DB_PATH=data/nova_memory.db

# Sprint 4A: Provider Gateway
# NOVA_PROVIDER_BASE_URL is the 9Router HOST ROOT only -- e.g.
# "https://api.9router.com" or "http://localhost:20128". Do NOT include a
# trailing "/v1": NineRouterAdapter always appends "/v1/chat/completions"
# itself, so a base URL ending in "/v1" would double it
# (".../v1/v1/chat/completions") and fail with HTTP 404. NOVA rejects a
# base URL ending in "/v1" at startup (see ProviderGatewayService._validate_config).
NOVA_PROVIDER_BASE_URL="https://api.9router.com"
NOVA_PROVIDER_API_KEY="replace_with_provider_api_key"
NOVA_PROVIDER_MODEL_PRIORITY="nova-v1,nova-v1-fallback,nova-v1-fast"
NOVA_PROVIDER_DEFAULT_MODEL="nova-v1"
NOVA_PROVIDER_ALLOWED_MODELS="nova-v1,nova-v1-fallback,nova-v1-fast"
# Optional direct specialist paths. These are not API credentials and are disabled by default.
NOVA_CODEX_EXECUTABLE_PATH=""
NOVA_CLAUDE_EXECUTABLE_PATH=""
# 9Router route aliases stay opaque; never put upstream provider identities here.
NOVA_PROVIDER_CODING_COMBO_PRIORITY="nova-v1-coding,nova-v1-coding-fallback"
NOVA_PROVIDER_REVIEW_COMBO_PRIORITY="nova-v1-review,nova-v1-review-fallback"

# Sprint 5G.1: NOVA internal alias -> 9Router upstream/combo route id.
# These override the registry defaults in app/providers/registry.py; use
# this only if your 9Router deployment's combo IDs differ from the ones
# evidenced against a real 9Router instance during this sprint (illustrative
# non-secret route IDs, not credentials -- verify against your own
# deployment's `GET /v1/models`):
#   nova-v1            -> general
#   nova-v1-fallback    -> general   (no distinct upstream fallback combo evidenced)
#   nova-v1-fast        -> Fast
#   nova-v1-coding      -> Development
#   nova-v1-review      -> review
# nova-v1-coding-fallback / nova-v1-review-fallback have NO default mapping
# (left unconfigured rather than fabricated) -- add them here only once a
# genuinely distinct upstream combo exists for them.
NOVA_PROVIDER_UPSTREAM_ROUTE_MAP="nova-v1:general,nova-v1-fallback:general,nova-v1-fast:Fast,nova-v1-coding:Development,nova-v1-review:review"

GOOGLE_CLIENT_SECRETS_PATH=
GOOGLE_TOKEN_STORAGE_PATH=
GOOGLE_OAUTH_PORT=0
